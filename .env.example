# Скопировать в .env и заполнить. Без этих значений стек не поднимется.
# Секреты генерировать так: openssl rand -base64 24

# --- админка ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- зона ---
DDNS_ZONE=example.com

# --- PowerDNS API (общий секрет с powerdns/pdns.conf) ---
PDNS_API_KEY=

# --- PostgreSQL ---
DB_NAME=powerdns
DB_USER=pdns
DB_PASSWORD=

# https, если перед приложением стоит reverse proxy с TLS
PUBLIC_SCHEME=https
