# Параметры площадки ns2. Скопировать в ns2.env и заполнить.
# setup-ns2.sh читает этот файл.

# Зона, которую забираем с ns1
ZONE=buten-ko.ru

# Адрес первичного сервера (ns1). От него принимаем NOTIFY и с него тянем AXFR.
NS1_IP=89.108.83.88

# TSIG-ключ для AXFR: имя и secret. Выдаёт /opt/buten-ddns/scripts/enable-axfr.sh
# на ns1 в конце своей работы. Без него зона не приедет.
TSIG_NAME=axfr-ns2
TSIG_SECRET=

# С каких адресов разрешён SSH на ns2 (через пробел).
# По умолчанию — только локальная сеть: наружу SSH не публикуется вообще.
# На время настройки сюда можно добавить внешний адрес, потом убрать.
SSH_ALLOW="192.168.88.0/24"

# Публичные адреса площадки, с которых ns2 ходит к ns1 за зоной.
# Их надо будет указать на ns1 в allow-axfr-ips (скрипт enable-axfr.sh примет списком).
# Оба PPPoE-адреса офиса — на случай, если маршрут переключится на второй канал.
AXFR_SOURCE_IPS="91.228.63.159,91.228.63.183"

# Публичный IP этого сервера (канал PTK2) — для самопроверки в check-ns2.sh
# и для glue-записи у регистратора
NS2_PUBLIC_IP=91.228.63.183
